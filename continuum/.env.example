# Copy this file to .env (same folder) and fill in your key. .env is private: it is never uploaded to GitHub.
# Your key: elevenlabs.io → your profile (bottom left) → API Keys → Create API key. Give it Text to Speech access
# and Voices read access.
ELEVENLABS_API_KEY=
# Optional: a voice ID from your ElevenLabs voice library. Leave empty for George. The app's Voice button lists the
# voices on your account, so you can also choose there.
ELEVENLABS_VOICE_ID=
# Optional: eleven_multilingual_v2 (best), eleven_turbo_v2_5 (cheaper, faster).
ELEVENLABS_MODEL=
