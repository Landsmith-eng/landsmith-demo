{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "description": "Continuum MVP: one node a day, write, flip to the source, walk the lineage.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "invite": "node --disable-warning=ExperimentalWarning scripts/invite.js",
    "check": "node --disable-warning=ExperimentalWarning scripts/check-content.js",
    "converge": "node --disable-warning=ExperimentalWarning scripts/find-convergences.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "proposals": "node --disable-warning=ExperimentalWarning scripts/proposals.js"
  },
  "dependencies": {
    "express": "5.1.0"
  }
}
